{
  "name": "chinese-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx scripts/seed.ts",
    "db:seed-scenarios": "tsx scripts/seed-scenarios.ts",
    "data:chars": "tsx scripts/build-char-data.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test",
    "data:examples": "tsx scripts/build-examples.ts",
    "data:strokes": "node scripts/copy-strokes.mjs",
    "predev": "node scripts/copy-strokes.mjs",
    "prebuild": "node scripts/copy-strokes.mjs && tsx scripts/deploy-db.ts",
    "data:dictionary": "tsx scripts/import-cedict.ts",
    "db:setup": "npm run db:migrate && npm run db:seed && npm run db:seed-scenarios && npm run data:dictionary",
    "db:deploy": "tsx scripts/deploy-db.ts",
    "data:word-audio": "tsx scripts/fetch-word-audio.ts",
    "smoke": "tsx scripts/smoke.ts",
    "e2e": "tsx scripts/e2e.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@libsql/client": "^0.18.0",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "dotenv": "^18.0.3",
    "drizzle-orm": "^0.45.3",
    "framer-motion": "^13.4.2",
    "hanzi-writer": "^3.7.3",
    "hanzi-writer-data": "^2.0.1",
    "lucide-react": "^1.47.0",
    "next": "16.3.6",
    "next-themes": "^0.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "ts-fsrs": "^5.4.2",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "playwright-core": "^1.63.0",
    "prettier": "^3.9.9",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
